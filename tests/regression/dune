; Bounded reclamation stress (random signals across start-up, run and shutdown); the full
; version is `make stress-processes` (1000 trials).

(rule
 (alias runtest-timing)
 (locks /timing)
 (deps process_stress.py clean_environment.py)
 (action
  (run
   python3
   -B
   %{dep:process_stress.py}
   %{exe:../../bin/fuzz/main.exe}
   --trials
   24
   --jobs
   2
   --seed
   503
   --max-seconds
   0.6
   --quiet)))

; One randomized trial of the process portfolio with synthetic children (no search), driven by
; process_chaos.py; make stress-processes runs 1000 of them.

(executable
 (name process_chaos)
 (modules process_chaos)
 (libraries axiom_fuzzer test_support unix))

(rule
 (alias runtest-timing)
 (locks /timing)
 (deps process_chaos.py)
 (action
  (run
   python3
   -B
   %{dep:process_chaos.py}
   %{exe:process_chaos.exe}
   --trials
   60
   --jobs
   4
   --seed
   503
   --kill-supervisor
   0.5
   --quiet)))


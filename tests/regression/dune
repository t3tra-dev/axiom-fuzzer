   %{dep:../../scripts/rocq_assumptions.py})))

(rule
 (alias runtest-timing)
 (locks /timing)
 (deps
  benchmark_test.py
  clean_environment.py
  ../../benchmarks/run.py
  ../../benchmarks/external.py
  ../../benchmarks/corpus.py
  (source_tree ../../benchmarks/problems))
 (action
  (run
   python3
   -B
   %{dep:benchmark_test.py}
   %{dep:../../benchmarks/run.py}
   %{exe:../../bin/fuzz/main.exe}
   %{exe:../../bin/mutate/main.exe}
   %{exe:../../benchmarks/progress_bench.exe})))


; Timing tier (runtest-timing): deadlines, signals and process reclamation, which depend on
; the wall clock and on scheduling; one timing test at a time (the /timing lock).

(executable
 (name deadline_tests)
 (modules deadline_tests)
 (libraries axiom_fuzzer test_support unix))

(rule
 (alias runtest-timing)
 (locks /timing)
 (action
  (run %{exe:deadline_tests.exe})))


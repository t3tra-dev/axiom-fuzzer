; Timing tier (runtest-timing): wall-clock behaviour, one timing test at a time.

(executable
 (name clock_tests)
 (modules clock_tests)
 (libraries axiom_fuzzer test_support unix))

(rule
 (alias runtest-timing)
 (locks /timing)
 (action
  (run %{exe:clock_tests.exe})))

